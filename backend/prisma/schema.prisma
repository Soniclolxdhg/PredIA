// PredIA - Sistema de Gestión Agrícola
// Definición Técnica de Base de Datos - PostgreSQL 16 con Prisma ORM v5.x
// Estándar de codificación: Español en entidades, relaciones y atributos

generator clientePrisma {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMERACIONES (ENUMS) EN ESPAÑOL
// ==========================================

enum RolUsuario {
  ADMINISTRADOR
  OPERADOR_CAMPO
  AGRONOMO
  CONTADOR
}

enum EstadoCiclo {
  EN_PLANIFICACION
  ACTIVO
  EN_COSECHA
  FINALIZADO
  CANCELADO
}

enum TipoLabor {
  SIEMBRA
  RIEGO
  FERTILIZACION
  PODA
  APLICACION_FITOSANITARIA
  COSECHA
  LIMPIEZA
}

enum EstadoLabor {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum CategoriaInsumo {
  FERTILIZANTE
  PESTICIDA
  SEMILLA
  HERRAMIENTA
  SUSTRATO
  OTRO
}

enum TipoMovimientoKardex {
  ENTRADA_COMPRA
  SALIDA_LABOR
  SALIDA_MERMA
  AJUSTE_INVENTARIO
}

enum EstadoNotaVenta {
  EMITIDA
  PAGADA
  ANULADA
}

// ==========================================
// 2. MODELOS: AUTENTICACIÓN Y SEGURIDAD
// ==========================================

/// Tabla 1: Usuarios del sistema (RBAC y Argon2)
model Usuario {
  id              String         @id @default(uuid()) @db.Uuid
  correo          String         @unique @db.VarChar(150)
  contrasenaHash  String         @db.VarChar(255)
  nombre          String         @db.VarChar(100)
  apellido        String         @db.VarChar(100)
  rol             RolUsuario     @default(OPERADOR_CAMPO)
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now()) @map("creado_en")
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en")

  // Relaciones
  registrosAuditoria RegistroAuditoria[]
  mermasRegistradas  MermaInsumo[]

  @@map("usuarios")
}

/// Tabla 2: Registros de Auditoría (Trazabilidad ISO 27001)
model RegistroAuditoria {
  id            String    @id @default(uuid()) @db.Uuid
  idUsuario     String?   @map("id_usuario") @db.Uuid
  accion        String    @db.VarChar(100)
  modulo        String    @db.VarChar(100)
  detalles      Json      @db.JsonB
  ipOrigen      String?   @map("ip_origen") @db.VarChar(45)
  agenteUsuario String?   @map("agente_usuario") @db.VarChar(255)
  creadoEn      DateTime  @default(now()) @map("creado_en")

  // Relaciones
  usuario       Usuario?  @relation(fields: [idUsuario], references: [id], onDelete: SetNull)

  @@index([idUsuario])
  @@index([modulo])
  @@index([creadoEn])
  @@map("registros_auditoria")
}

// ==========================================
// 3. MODELOS: PRODUCCIÓN AGRÍCOLA
// ==========================================

/// Tabla 3: Naves de cultivo / Invernaderos
model Nave {
  id              String         @id @default(uuid()) @db.Uuid
  codigo          String         @unique @db.VarChar(50)
  nombre          String         @db.VarChar(150)
  superficieM2    Decimal        @map("superficie_m2") @db.Decimal(12, 2)
  tipoEstructura  String?        @map("tipo_estructura") @db.VarChar(100)
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now()) @map("creado_en")
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en")

  // Relaciones
  ciclosCultivo   CicloCultivo[]

  @@map("naves")
}

/// Tabla 4: Ciclos de Cultivo
model CicloCultivo {
  id                String         @id @default(uuid()) @db.Uuid
  idNave            String         @map("id_nave") @db.Uuid
  variedad          String         @db.VarChar(100)
  fechaInicio       DateTime       @map("fecha_inicio") @db.Date
  fechaFinEstimada  DateTime?      @map("fecha_fin_estimada") @db.Date
  fechaFinReal      DateTime?      @map("fecha_fin_real") @db.Date
  estado            EstadoCiclo    @default(EN_PLANIFICACION)
  telemetria        Json?          @db.JsonB
  creadoEn          DateTime       @default(now()) @map("creado_en")
  actualizadoEn     DateTime       @updatedAt @map("actualizado_en")

  // Relaciones
  nave              Nave           @relation(fields: [idNave], references: [id], onDelete: Restrict)
  laboresCampo      LaborCampo[]
  costosIndirectos  CostoIndirecto[]
  liquidaciones     LiquidacionCostoCiclo[]
  notasVenta        NotaVenta[]

  @@index([idNave])
  @@index([estado])
  @@map("ciclos_cultivo")
}

/// Tabla 5: Labores de Campo
model LaborCampo {
  id              String         @id @default(uuid()) @db.Uuid
  idCicloCultivo  String         @map("id_ciclo_cultivo") @db.Uuid
  tipoLabor       TipoLabor      @map("tipo_labor")
  fechaProgramada DateTime       @map("fecha_programada") @db.Date
  fechaEjecucion  DateTime?      @map("fecha_ejecucion") @db.Date
  descripcion     String?        @db.Text
  estado          EstadoLabor    @default(PENDIENTE)
  creadoEn        DateTime       @default(now()) @map("creado_en")
  actualizadoEn   DateTime       @updatedAt @map("actualizado_en")

  // Relaciones
  cicloCultivo    CicloCultivo   @relation(fields: [idCicloCultivo], references: [id], onDelete: Cascade)
  jornales        Jornal[]

  @@index([idCicloCultivo])
  @@index([tipoLabor])
  @@map("labores_campo")
}

// ==========================================
// 4. MODELOS: INVENTARIO, KARDEX Y MERMAS
// ==========================================

/// Tabla 6: Insumos Agrícolas
model Insumo {
  id              String           @id @default(uuid()) @db.Uuid
  codigo          String           @unique @db.VarChar(50)
  nombre          String           @db.VarChar(150)
  categoria       CategoriaInsumo
  unidadMedida    String           @map("unidad_medida") @db.VarChar(30)
  stockActual     Decimal          @default(0) @map("stock_actual") @db.Decimal(12, 2)
  costoUnitario   Decimal          @map("costo_unitario") @db.Decimal(12, 2)
  stockMinimo     Decimal          @default(0) @map("stock_minimo") @db.Decimal(12, 2)
  activo          Boolean          @default(true)
  creadoEn        DateTime         @default(now()) @map("creado_en")
  actualizadoEn   DateTime         @updatedAt @map("actualizado_en")

  // Relaciones
  movimientosKardex MovimientoKardex[]
  mermas            MermaInsumo[]

  @@map("insumos")
}

/// Tabla 7: Kardex de Inventario (Movimientos y Trazabilidad)
model MovimientoKardex {
  id              String               @id @default(uuid()) @db.Uuid
  idInsumo        String               @map("id_insumo") @db.Uuid
  tipoMovimiento  TipoMovimientoKardex @map("tipo_movimiento")
  cantidad        Decimal              @db.Decimal(12, 2)
  costoUnitario   Decimal              @map("costo_unitario") @db.Decimal(12, 2)
  costoTotal      Decimal              @map("costo_total") @db.Decimal(12, 2)
  idReferencia    String?              @map("id_referencia") @db.VarChar(100)
  saldoStock      Decimal              @map("saldo_stock") @db.Decimal(12, 2)
  observaciones   String?              @db.Text
  creadoEn        DateTime             @default(now()) @map("creado_en")

  // Relaciones
  insumo          Insumo               @relation(fields: [idInsumo], references: [id], onDelete: Restrict)

  @@index([idInsumo])
  @@index([tipoMovimiento])
  @@map("movimientos_kardex")
}

/// Tabla 8: Mermas de Insumos
model MermaInsumo {
  id            String    @id @default(uuid()) @db.Uuid
  idInsumo      String    @map("id_insumo") @db.Uuid
  idUsuario     String?   @map("id_usuario") @db.Uuid
  cantidad      Decimal   @db.Decimal(12, 2)
  motivo        String    @db.VarChar(255)
  fecha         DateTime  @db.Date
  observaciones String?   @db.Text
  creadoEn      DateTime  @default(now()) @map("creado_en")

  // Relaciones
  insumo        Insumo    @relation(fields: [idInsumo], references: [id], onDelete: Restrict)
  usuario       Usuario?  @relation(fields: [idUsuario], references: [id], onDelete: SetNull)

  @@index([idInsumo])
  @@map("mermas_insumo")
}

// ==========================================
// 5. MODELOS: MANO DE OBRA Y COSTOS
// ==========================================

/// Tabla 9: Trabajadores de Campo
model Trabajador {
  id                  String    @id @default(uuid()) @db.Uuid
  rutOIdentificacion  String    @unique @map("rut_o_identificacion") @db.VarChar(30)
  nombre              String    @db.VarChar(100)
  apellido            String    @db.VarChar(100)
  cargo               String    @db.VarChar(100)
  costoHora           Decimal   @map("costo_hora") @db.Decimal(12, 2)
  activo              Boolean   @default(true)
  creadoEn            DateTime  @default(now()) @map("creado_en")
  actualizadoEn       DateTime  @updatedAt @map("actualizado_en")

  // Relaciones
  jornales            Jornal[]

  @@map("trabajadores")
}

/// Tabla 10: Jornales (Mano de obra aplicada por labor)
model Jornal {
  id              String      @id @default(uuid()) @db.Uuid
  idTrabajador    String      @map("id_trabajador") @db.Uuid
  idLaborCampo    String      @map("id_labor_campo") @db.Uuid
  horasTrabajadas Decimal     @map("horas_trabajadas") @db.Decimal(12, 2)
  costoPorHora    Decimal     @map("costo_por_hora") @db.Decimal(12, 2)
  costoTotal      Decimal     @map("costo_total") @db.Decimal(12, 2)
  fecha           DateTime    @db.Date
  creadoEn        DateTime    @default(now()) @map("creado_en")

  // Relaciones
  trabajador      Trabajador  @relation(fields: [idTrabajador], references: [id], onDelete: Restrict)
  laborCampo      LaborCampo  @relation(fields: [idLaborCampo], references: [id], onDelete: Cascade)

  @@index([idTrabajador])
  @@index([idLaborCampo])
  @@map("jornales")
}

/// Tabla 11: Costos Indirectos de Fabricación y Operación
model CostoIndirecto {
  id              String        @id @default(uuid()) @db.Uuid
  idCicloCultivo  String        @map("id_ciclo_cultivo") @db.Uuid
  concepto        String        @db.VarChar(150)
  monto           Decimal       @db.Decimal(12, 2)
  fecha           DateTime      @db.Date
  periodo         String?       @db.VarChar(50)
  observaciones   String?       @db.Text
  creadoEn        DateTime      @default(now()) @map("creado_en")

  // Relaciones
  cicloCultivo    CicloCultivo  @relation(fields: [idCicloCultivo], references: [id], onDelete: Cascade)

  @@index([idCicloCultivo])
  @@map("costos_indirectos")
}

// ==========================================
// 6. MODELOS: MOTOR DE COSTEO DOMINIO ($/KG)
// ==========================================

/// Tabla 12: Liquidación de Costo del Ciclo (Cálculo $/Kg)
model LiquidacionCostoCiclo {
  id                      String        @id @default(uuid()) @db.Uuid
  idCicloCultivo          String        @map("id_ciclo_cultivo") @db.Uuid
  costoTotalInsumos       Decimal       @map("costo_total_insumos") @db.Decimal(12, 2)
  costoTotalManoObra      Decimal       @map("costo_total_mano_obra") @db.Decimal(12, 2)
  costoTotalIndirectos    Decimal       @map("costo_total_indirectos") @db.Decimal(12, 2)
  costoTotalGeneral       Decimal       @map("costo_total_general") @db.Decimal(12, 2)
  kilosProducidos         Decimal       @map("kilos_producidos") @db.Decimal(12, 2)
  costoUnitarioPorKilo    Decimal       @map("costo_unitario_por_kilo") @db.Decimal(12, 2)
  fechaCalculo            DateTime      @default(now()) @map("fecha_calculo")
  desgloseCostos          Json          @map("desglose_costos") @db.JsonB
  creadoEn                DateTime      @default(now()) @map("creado_en")

  // Relaciones
  cicloCultivo            CicloCultivo  @relation(fields: [idCicloCultivo], references: [id], onDelete: Cascade)

  @@index([idCicloCultivo])
  @@map("liquidaciones_costo_ciclo")
}

// ==========================================
// 7. MODELOS: VENTAS, CLIENTES Y MÁRGENES
// ==========================================

/// Tabla 13: Clientes Compradores
model Cliente {
  id              String       @id @default(uuid()) @db.Uuid
  razonSocial     String       @map("razon_social") @db.VarChar(150)
  rutONit         String       @unique @map("rut_o_nit") @db.VarChar(30)
  direccion       String?      @db.VarChar(255)
  telefono        String?      @db.VarChar(30)
  email           String?      @db.VarChar(100)
  activo          Boolean      @default(true)
  creadoEn        DateTime     @default(now()) @map("creado_en")
  actualizadoEn   DateTime     @updatedAt @map("actualizado_en")

  // Relaciones
  notasVenta      NotaVenta[]

  @@map("clientes")
}

/// Tabla 14: Notas de Venta y Márgenes Comerciales
model NotaVenta {
  id                String          @id @default(uuid()) @db.Uuid
  idCliente         String          @map("id_cliente") @db.Uuid
  idCicloCultivo    String          @map("id_ciclo_cultivo") @db.Uuid
  numeroComprobante String          @unique @map("numero_comprobante") @db.VarChar(50)
  fecha             DateTime        @db.Date
  totalKilos        Decimal         @map("total_kilos") @db.Decimal(12, 2)
  precioPorKilo     Decimal         @map("precio_por_kilo") @db.Decimal(12, 2)
  subtotal          Decimal         @db.Decimal(12, 2)
  impuesto          Decimal         @default(0) @db.Decimal(12, 2)
  total             Decimal         @db.Decimal(12, 2)
  costoEstimadoKg   Decimal         @map("costo_estimado_kg") @db.Decimal(12, 2)
  margenBruto       Decimal         @map("margen_bruto") @db.Decimal(12, 2)
  estado            EstadoNotaVenta @default(EMITIDA)
  creadoEn          DateTime        @default(now()) @map("creado_en")
  actualizadoEn     DateTime        @updatedAt @map("actualizado_en")

  // Relaciones
  cliente           Cliente         @relation(fields: [idCliente], references: [id], onDelete: Restrict)
  cicloCultivo      CicloCultivo    @relation(fields: [idCicloCultivo], references: [id], onDelete: Restrict)

  @@index([idCliente])
  @@index([idCicloCultivo])
  @@map("notas_venta")
}

// ==========================================
// 8. MODELO: HISTÓRICO Y CACHÉ CLIMÁTICO
// ==========================================

/// Tabla 15: Caché de Histórico de Clima (Open-Meteo REST API)
model HistoricoClima {
  id                    String    @id @default(uuid()) @db.Uuid
  latitud               Decimal   @db.Decimal(12, 6)
  longitud              Decimal   @db.Decimal(12, 6)
  fecha                 DateTime  @db.Date
  temperaturaPromedio   Decimal   @map("temperatura_promedio") @db.Decimal(12, 2)
  temperaturaMaxima     Decimal   @map("temperatura_maxima") @db.Decimal(12, 2)
  temperaturaMinima     Decimal   @map("temperatura_minima") @db.Decimal(12, 2)
  humedadRelativa       Decimal   @map("humedad_relativa") @db.Decimal(12, 2)
  precipitacionMm       Decimal   @map("precipitacion_mm") @db.Decimal(12, 2)
  velocidadVientoKmH    Decimal   @map("velocidad_viento_kmh") @db.Decimal(12, 2)
  datosHorarios         Json?     @map("datos_horarios") @db.JsonB
  alertasClimaticas     Json?     @map("alertas_climaticas") @db.JsonB
  creadoEn              DateTime  @default(now()) @map("creado_en")

  @@unique([latitud, longitud, fecha])
  @@index([fecha])
  @@map("historico_clima")
}
